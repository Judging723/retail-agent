RETAIL_APP_NAME=Retail Agent Backend
RETAIL_SERVICE_NAME=retail-agent-backend
RETAIL_APP_VERSION=0.1.0
RETAIL_ENVIRONMENT=development
RETAIL_API_V1_PREFIX=/api/v1

RETAIL_DB_HOST=127.0.0.1
RETAIL_DB_PORT=3307
RETAIL_DB_NAME=retail_agent
RETAIL_DB_USER=retail_app
RETAIL_DB_PASSWORD=replace-with-local-password
RETAIL_DB_ECHO=false

RETAIL_LLM_API_BASE=https://api.deepseek.com
RETAIL_LLM_API_KEY=
RETAIL_LLM_MODEL=deepseek-flash

# Optional override; the default points to knowledge-pipeline/data/vector_store/retail_agent.db
# RETAIL_MILVUS_URI=/absolute/path/to/retail_agent.db
RETAIL_MILVUS_COLLECTION=retail_knowledge
