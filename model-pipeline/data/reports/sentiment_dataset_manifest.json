    }
  },
  "label_policy": {
    "classes": [
      "negative",
      "neutral",
      "positive"
    ],
    "rule": "argmax(p_negative, p_neutral, p_positive)",
    "teacher_model": "lxyuan/distilbert-base-multilingual-cased-sentiments-student",
    "warning": "Labels are model-generated pseudo-labels on synthetic conversations, not human gold annotations. Metrics measure agreement with the teacher labels."
  },
  "transformation": {
    "language": "zh",
    "role": "b (customer) only",
    "split_strategy": "sha256('kapibala:' + setting_id) bucket: train 0-79, dev 80-89, test 90-99",
    "deduplication": "exact normalized message text; conflicting labels are rejected",
    "pii_policy": "no redaction; the source dataset declares all conversations synthetic"
  },
