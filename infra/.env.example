MYSQL_DATABASE=retail_agent
MYSQL_USER=retail_app
MYSQL_PASSWORD=retail_dev_password
MYSQL_ROOT_PASSWORD=retail_root_dev_password

# Replace before using the application profile outside local development.
RETAIL_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# DeepSeek or another OpenAI-compatible endpoint.
RETAIL_LLM_API_BASE=https://api.deepseek.com
RETAIL_LLM_API_KEY=
RETAIL_LLM_MODEL=deepseek-flash
RETAIL_LLM_TIMEOUT_SECONDS=60
RETAIL_LLM_MAX_RETRIES=1
